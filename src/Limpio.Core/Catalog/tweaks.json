    {
      "id": "apps.onedrive",
      "category": "apps",
      "title": {
        "es": "Desinstalar OneDrive",
        "en": "Uninstall OneDrive"
      },
      "description": {
        "es": "Desinstala OneDrive y quita su inicio automático. No borra tu carpeta OneDrive.",
        "en": "Uninstalls OneDrive and removes its autostart. Your OneDrive folder is never deleted."
      },
      "risk": "moderate",
      "presets": [
        "aggressive"
      ],
      "actions": [
        {
          "type": "win32Uninstall",
          "displayName": "Microsoft OneDrive",
          "processName": "OneDrive",
          "uninstallers": [
            "%SystemRoot%\\System32\\OneDriveSetup.exe",
            "%SystemRoot%\\SysWOW64\\OneDriveSetup.exe",
            "%LOCALAPPDATA%\\Microsoft\\OneDrive\\*\\OneDriveSetup.exe"
          ],
          "uninstallArgs": "/uninstall",
          "runValueName": "OneDrive",
          "protectKnownFolders": true,
          "revertHint": "https://www.microsoft.com/microsoft-365/onedrive/download  |  winget install Microsoft.OneDrive"
        }
      ],
      "note": {
        "es": "Se omite si Escritorio, Documentos o Imágenes están dentro de OneDrive. Reinstala desde microsoft.com/microsoft-365/onedrive/download o con winget install Microsoft.OneDrive.",
        "en": "Refused if Desktop, Documents or Pictures live inside OneDrive. Reinstall from microsoft.com/microsoft-365/onedrive/download or with winget install Microsoft.OneDrive."
      }
    },
    {
      "id": "gaming.gamebar",
      "category": "privacy",
      "title": {
        "es": "Barra de juegos y captura (Game Bar)",
        "en": "Game Bar and capture"
      },
      "description": {
        "es": "Desactiva la captura de Game DVR y la barra de juegos.",
        "en": "Turns off Game DVR capture and the Game Bar."
      },
      "risk": "moderate",
      "presets": [
        "aggressive"
      ],
      "actions": [
        {
          "type": "registry",
          "hive": "HKCU",
          "path": "Software\\Microsoft\\Windows\\CurrentVersion\\GameDVR",
          "name": "AppCaptureEnabled",
          "valueType": "dword",
          "value": 0
        },
        {
          "type": "registry",
          "hive": "HKCU",
          "path": "System\\GameConfigStore",
          "name": "GameDVR_Enabled",
          "valueType": "dword",
          "value": 0
        }
      ],
      "note": {
        "es": "Déjalo si grabas partidas con Game Bar.",
        "en": "Keep it if you record gameplay with Game Bar."
      }
    },
