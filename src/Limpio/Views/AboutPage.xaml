<Page x:Class="Limpio.Views.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:svc="clr-namespace:Limpio.Services"
      Title="About">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,12,32,32" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageTitle}" Text="{svc:L about.title}" />
            <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,4,0,16" Text="{svc:L about.subtitle}" />

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{svc:L about.version}" />
                    <TextBlock x:Name="VersionText" Margin="0,4,0,12" />
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{svc:L about.license}" />
                    <TextBlock Margin="0,4,0,12" Text="{svc:L about.licenseText}" />
                    <ui:HyperlinkButton Content="github.com/fsoftt/limpio" NavigateUri="https://github.com/fsoftt/limpio"
                                        Icon="{ui:SymbolIcon Open24}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{svc:L about.disclaimerTitle}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" Text="{svc:L about.disclaimer}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
