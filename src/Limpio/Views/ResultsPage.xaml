<Page x:Class="Limpio.Views.ResultsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:svc="clr-namespace:Limpio.Services"
      xmlns:ctl="clr-namespace:Limpio.Controls"
      Title="Results">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,12,32,32">
            <TextBlock Style="{StaticResource PageTitle}" Text="{svc:L results.title}" />
            <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,4,0,16" Text="{svc:L results.subtitle}" />

            <WrapPanel Margin="0,0,0,12">
                <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon ArrowSync24}" Content="{svc:L results.measure}"
                           Command="{Binding MeasureCommand}" Margin="0,0,8,8" />
                <ui:Button Icon="{ui:SymbolIcon Flag24}" Content="{svc:L results.resetBaseline}"
                           Command="{Binding ResetBaselineCommand}" Margin="0,0,8,8" />
                <ui:Button Icon="{ui:SymbolIcon Image24}" Content="{svc:L results.exportPng}" Click="OnExportPng" Margin="0,0,8,8" />
                <ui:Button Icon="{ui:SymbolIcon DocumentText24}" Content="{svc:L results.exportMd}" Click="OnExportMd" Margin="0,0,8,8" />
                <ui:ProgressRing Width="24" Height="24" IsIndeterminate="True" Margin="8,0,0,8"
                                 Visibility="{Binding IsMeasuring, Converter={StaticResource B2V}}" />
            </WrapPanel>

            <ui:InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Margin="0,0,0,12"
                        Title="{svc:L results.noticeTitle}" Message="{svc:L results.notice}" />
            <ui:InfoBar IsOpen="{Binding IsDemo, Mode=OneWay}" IsClosable="False" Severity="Warning" Margin="0,0,0,12"
                        Title="Demo" Message="{svc:L results.demo}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,8" Text="{Binding Status}" />

            <TextBlock Style="{StaticResource Muted}" Text="{svc:L results.nodata}"
                       Visibility="{Binding HasData, Converter={StaticResource InvB2V}}" />

            <StackPanel x:Name="ExportRoot" Visibility="{Binding HasData, Converter={StaticResource B2V}}"
                        Background="{DynamicResource ApplicationBackgroundBrush}">
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" Text="{svc:L results.before}" />
                            <TextBlock Style="{StaticResource Muted}" HorizontalAlignment="Center" Text="{Binding BeforeDate}" />
                            <ctl:Gauge Width="150" Height="150" Margin="0,8,0,0" Thickness="12" Value="{Binding BeforeScore}"
                                       TrackBrush="#33808080"
                                       ArcBrush="#8A8A8A" TextBrush="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="32,0">
                            <ui:SymbolIcon Symbol="ArrowRight24" FontSize="36" Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                            <TextBlock Style="{StaticResource Muted}" HorizontalAlignment="Center" Text="{svc:L m.privacy}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" Text="{svc:L results.after}" />
                            <TextBlock Style="{StaticResource Muted}" HorizontalAlignment="Center" Text="{Binding AfterDate}" />
                            <ctl:Gauge Width="150" Height="150" Margin="0,8,0,0" Thickness="12" Value="{Binding AfterScore}"
                                       TrackBrush="#33808080"
                                       ArcBrush="#2E9E5B" TextBrush="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding Cards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,12,12" Padding="16" Width="270">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Muted}" FontWeight="SemiBold" Text="{Binding Label}" />
                                    <Grid Margin="0,12,0,0">
                                        <TextBlock FontSize="12" Style="{StaticResource Muted}" Text="{svc:L results.before}" />
                                        <TextBlock HorizontalAlignment="Right" Text="{Binding BeforeText}" />
                                    </Grid>
                                    <ctl:RatioBar Margin="0,4,0,0" Ratio="{Binding BeforeRatio}" Fill="#8A8A8A"
                                                  Track="#33808080" />
                                    <Grid Margin="0,10,0,0">
                                        <TextBlock FontSize="12" Style="{StaticResource Muted}" Text="{svc:L results.after}" />
                                        <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding AfterText}" />
                                    </Grid>
                                    <ctl:RatioBar Margin="0,4,0,0" Ratio="{Binding AfterRatio}" Fill="{Binding DeltaBrush}"
                                                  Track="#33808080" />
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <ui:SymbolIcon Symbol="{Binding ArrowGlyph}" Foreground="{Binding DeltaBrush}" FontSize="18" />
                                        <TextBlock Margin="6,0,0,0" FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{Binding DeltaBrush}" Text="{Binding DeltaText}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
